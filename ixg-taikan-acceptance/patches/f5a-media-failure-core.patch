index 000000000..4ebb6a1b9
--- /dev/null
+++ b/src/agents/tools/media-tool-failure.test.ts
@@ -0,0 +1,169 @@
+// Covers the model-facing Japanese failure texts for media-loading tools.
+import { describe, expect, it } from "vitest";
+import { MediaFetchError } from "../../media/fetch.js";
+import { LocalMediaAccessError } from "../../media/local-media-access.js";
+import { readToolOperatorHint } from "../tool-operator-hint.js";
+import {
+  buildNotPdfFailure,
+  explainMediaToolFailure,
+  toMediaToolFailure,
+} from "./media-tool-failure.js";
+
+const ctx = (extra: Record<string, unknown> = {}) => ({
+  toolName: "pdf",
+  noun: "PDF ファイル",
+  ...extra,
+});
+
+const httpError = (status: number, body = "secret-body") =>
+  new MediaFetchError(
+    "http_error",
+    `Failed to fetch media from https://files.example.invalid/private/a.pdf?sig=abc: HTTP ${status}; body: ${body}`,
+    { status },
+  );
+
+const textOf = (error: unknown) => (error as Error).message;
+
+describe("toMediaToolFailure: URL fetch", () => {
+  it.each([401, 403])(
+    "HTTP %i: says where it failed, how to open it, and what to ask the customer",
+    (status) => {
+      const error = toMediaToolFailure(ctx(), httpError(status)) as Error & { status?: number };
+      const text = error.message;
+      expect(text).toContain("pdf ツールで失敗しました（段階: URL の取得");
+      expect(text).toContain(`HTTP ${status}`);
+      expect(text).toContain("認証が必要");
+      expect(text).toContain("認証情報を送れない");
+      expect(text).toContain("認証付きで取得できる道具");
+      expect(text).toContain("作業場（workspace）に保存し、作業場の中のパスを pdf ツールに渡す");
+      expect(text).toContain("利用者に");
+      expect(text).toContain("添付");
+      expect(text).toContain("共有設定を開く");
+      expect(text).toContain("利用者はこちらの内部の状況を知りません");
+      expect(error.status).toBe(status);
+    },
+  );
+
+  it("keeps URL, query, origin body and credentials out of the text", () => {
+    for (const status of [401, 403, 404, 410, 418, 500, 503]) {
+      const text = textOf(toMediaToolFailure(ctx(), httpError(status)));
+      expect(text, String(status)).not.toMatch(/files\.example|sig=abc|secret-body|https?:\/\//);
+    }
+  });
+
+  it("HTTP 404, 5xx and other 4xx each name the stage and ask the customer for the file", () => {
+    for (const [status, phrase] of [
+      [404, "見つかりませんでした"],
+      [503, "試し直すのは 1 回まで"],
+      [418, "断られました"],
+    ] as const) {
+      const text = textOf(toMediaToolFailure(ctx(), httpError(status)));
+      expect(text).toContain(`段階: URL の取得、HTTP ${status}`);
+      expect(text).toContain(phrase);
+      expect(text).toContain("添付");
+    }
+  });
+
+  it("a network failure carries a URL-free reason", () => {
+    const original = new MediaFetchError(
+      "fetch_failed",
+      "Failed to fetch media from https://files.example.invalid/x.pdf: connect ECONNREFUSED https://10.0.0.1:443/x",
+    );
+    const text = textOf(toMediaToolFailure(ctx(), original));
+    expect(text).toContain("段階: URL の取得）");
+    expect(text).toContain("理由: connect ECONNREFUSED <URL>");
+    expect(text).not.toMatch(/example\.invalid|10\.0\.0\.1/);
+  });
+
+  it("uses the tool's own name and noun", () => {
+    const text = textOf(
+      toMediaToolFailure(ctx({ toolName: "view_image", noun: "画像ファイル" }), httpError(401)),
+    );
+    expect(text).toContain("view_image ツールで失敗しました");
+    expect(text).toContain("画像ファイルそのものの添付");
+    expect(text).not.toContain("PDF");
+  });
+});
+
+describe("toMediaToolFailure: local file", () => {
+  const denied = () =>
+    new LocalMediaAccessError(
+      "path-not-allowed",
+      "Local media path is not under an allowed directory: /home/secret-user/private/report.pdf",
+    );
+
+  it("lists the allowed roots and the remedy, without repeating the denied path", () => {
+    const roots = ["/state/workspace", "/tmp/openclaw", "/state/media"];
+    const error = toMediaToolFailure(ctx({ allowedRoots: roots }), denied());
+    const text = textOf(error);
+    expect(text).toContain("pdf ツールで失敗しました（段階: ローカルファイルの読み取り）");
+    expect(text).toContain("許可されている場所: /state/workspace、/tmp/openclaw、/state/media");
+    expect(text).toContain("移すかコピーして");
+    expect(text).toContain("添付を頼む");
+    expect(text).toContain("利用者はこちらの内部の状況を知りません");
+    expect(text).toContain("Local media path is not under an allowed directory");
+    expect(text).not.toMatch(/secret-user|report\.pdf/);
+  });
+
+  it("shortens a long root list and falls back to the workspace when no roots are known", () => {
+    const many = Array.from({ length: 11 }, (_, i) => `/root/${i}`);
+    expect(textOf(toMediaToolFailure(ctx({ allowedRoots: many }), denied()))).toContain(
+      "/root/7 ほか 3 件",
+    );
+    expect(textOf(toMediaToolFailure(ctx(), denied()))).toContain(
+      "許可されている場所: 作業場（workspace）の中",
+    );
+  });
+
+  it("explains a missing file; other local errors pass through untouched", () => {
+    const missing = new LocalMediaAccessError("not-found", "Local media file not found: /x/y.pdf");
+    const text = textOf(toMediaToolFailure(ctx(), missing));
+    expect(text).toContain("指定のパスにファイルがありません");
+    expect(text).not.toContain("/x/y.pdf");
+    const unsafe = new LocalMediaAccessError(
+      "invalid-path",
+      "Local media path is not safe to read: /x",
+    );
+    expect(toMediaToolFailure(ctx(), unsafe)).toBe(unsafe);
+  });
+});
+
+describe("pass-through and helpers", () => {
+  it("returns aborts, unknown errors and non-errors unchanged", () => {
+    const abort = Object.assign(new Error("aborted"), { name: "AbortError" });
+    const plain = new Error("something else");
+    expect(toMediaToolFailure(ctx(), abort)).toBe(abort);
+    expect(toMediaToolFailure(ctx(), plain)).toBe(plain);
+    expect(toMediaToolFailure(ctx(), "text")).toBe("text");
+    const controller = new AbortController();
+    controller.abort();
+    const http = httpError(401);
+    expect(toMediaToolFailure(ctx({ signal: controller.signal }), http)).toBe(http);
+  });
+
+  it("keeps the original error as cause and as an operator-only hint", () => {
+    const original = httpError(401);
+    const error = toMediaToolFailure(ctx(), original) as Error;
+    expect(error.cause).toBe(original);
+    expect(readToolOperatorHint(error)).toContain("HTTP 401");
+    expect(error.message).not.toContain("original error");
+  });
+
+  it("explainMediaToolFailure passes results through and rethrows failures as text", async () => {
+    await expect(explainMediaToolFailure(ctx(), async () => "ok")).resolves.toBe("ok");
+    await expect(
+      explainMediaToolFailure(ctx(), async () => {
+        throw httpError(403);
+      }),
+    ).rejects.toThrow("pdf ツールで失敗しました（段階: URL の取得、HTTP 403）");
+  });
+
+  it("describes content that is not a PDF (stage: content type) without the reference", () => {
+    const text = buildNotPdfFailure(ctx(), "text/html").message;
+    expect(text).toContain("段階: 内容の種類の確認");
+    expect(text).toContain("PDF ではありませんでした（種類: text/html）");
+    expect(text).toContain("Expected PDF but got text/html");
+    expect(buildNotPdfFailure(ctx(), "x y; z").message).toContain("種類: 不明");
+    expect(buildNotPdfFailure(ctx(), undefined).message).toContain("種類: 不明");
+  });
+});
