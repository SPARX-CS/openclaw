diff --git a/src/gateway/mcp-http.handlers.failure-hint.test.ts b/src/gateway/mcp-http.handlers.failure-hint.test.ts
new file mode 100644
index 000000000..1df443bb7
--- /dev/null
+++ b/src/gateway/mcp-http.handlers.failure-hint.test.ts
@@ -0,0 +1,109 @@
+// Covers the consecutive tool-failure hint on the CLI runtimes' MCP loopback path.
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { AnyAgentTool } from "../agents/tools/common.js";
+import { resetDiagnosticSessionStateForTest } from "../logging/diagnostic-session-state.js";
+import { handleMcpJsonRpc } from "./mcp-http.handlers.js";
+
+type CallResult = { result: { content: Array<{ type: "text"; text: string }>; isError: boolean } };
+
+function createTool(failFor: (args: { url?: string }, call: number) => Error | undefined) {
+  let calls = 0;
+  return {
+    name: "pdf",
+    label: "PDF",
+    description: "pdf stand-in",
+    parameters: { type: "object", properties: {} } as never,
+    execute: vi.fn(async (_id: string, args: { url?: string }) => {
+      calls += 1;
+      const failure = failFor(args, calls);
+      if (failure) {
+        throw failure;
+      }
+      return { content: [{ type: "text" as const, text: "summary" }], details: { status: "ok" } };
+    }),
+  } as unknown as AnyAgentTool;
+}
+
+async function call(
+  tool: AnyAgentTool,
+  url: string,
+  hookContext?: Parameters<typeof handleMcpJsonRpc>[0]["hookContext"],
+) {
+  const response = await handleMcpJsonRpc({
+    message: {
+      jsonrpc: "2.0",
+      id: 1,
+      method: "tools/call",
+      params: { name: tool.name, arguments: { url } },
+    },
+    tools: [tool],
+    toolSchema: [
+      { name: tool.name, description: tool.description, inputSchema: { type: "object" } },
+    ],
+    ...(hookContext ? { hookContext } : {}),
+  });
+  const result = (response as CallResult).result;
+  return {
+    isError: result.isError,
+    first: result.content[0]?.text ?? "",
+    hint: result.content.find((block) => block.text.startsWith("[システム通知"))?.text,
+  };
+}
+
+const unauthorized = (url?: string) =>
+  Object.assign(new Error(`Failed to fetch media from ${url}: HTTP 401 Unauthorized`), {
+    status: 401,
+  });
+
+describe("MCP loopback tool failure hint", () => {
+  beforeEach(() => {
+    resetDiagnosticSessionStateForTest();
+  });
+
+  it("adds the hint from the 3rd consecutive failure, whatever the URL, and never blocks", async () => {
+    const tool = createTool((args) => unauthorized(args.url));
+    const hookContext = { sessionKey: "agent:main:mcp-hint-a", runId: "run-1" };
+    const hints: boolean[] = [];
+    for (let i = 1; i <= 6; i += 1) {
+      const out = await call(tool, `https://example.invalid/v${i}.pdf`, hookContext);
+      expect(out.isError).toBe(true);
+      expect(out.first).toContain("HTTP 401");
+      expect(out.first).not.toContain("システム通知");
+      hints.push(out.hint !== undefined);
+    }
+    expect(hints).toEqual([false, false, true, true, true, true]);
+    expect(tool.execute).toHaveBeenCalledTimes(6);
+  });
+
+  it("restarts after a success of the tool and follows tools.failureHint.afterConsecutiveFailures", async () => {
+    const tool = createTool((args, n) => (n === 2 ? undefined : unauthorized(args.url)));
+    const hookContext = {
+      sessionKey: "agent:main:mcp-hint-b",
+      runId: "run-1",
+      config: { tools: { failureHint: { afterConsecutiveFailures: 2 } } } as never,
+    };
+    const trace: string[] = [];
+    for (let i = 1; i <= 5; i += 1) {
+      const out = await call(tool, `https://example.invalid/${i}`, hookContext);
+      trace.push(`${out.isError ? "error" : "ok"}${out.hint ? "+hint" : ""}`);
+    }
+    // call 1 fails; 2 succeeds (reset); 3 fails; 4 is the 2nd failure since; 5 too.
+    expect(trace).toEqual(["error", "ok", "error", "error+hint", "error+hint"]);
+  });
+
+  it("gives no hint when disabled (0) or without a session", async () => {
+    const off = createTool((args) => unauthorized(args.url));
+    const offContext = {
+      sessionKey: "agent:main:mcp-hint-c",
+      runId: "run-1",
+      config: { tools: { failureHint: { afterConsecutiveFailures: 0 } } } as never,
+    };
+    for (let i = 1; i <= 5; i += 1) {
+      expect((await call(off, `https://example.invalid/${i}`, offContext)).hint).toBeUndefined();
+    }
+    const anonymous = createTool((args) => unauthorized(args.url));
+    for (let i = 1; i <= 5; i += 1) {
+      expect((await call(anonymous, `https://example.invalid/${i}`)).hint).toBeUndefined();
+    }
+  });
+});
