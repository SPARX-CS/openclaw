+    const hookContext = {
+      agentId: "main",
+      sessionKey: `agent:main:failure-hint-${sessionCounter}`,
+      sessionId: `failure-hint-session-${sessionCounter}`,
+      runId: "run-failure-hint",
+      ...(config ? { config } : {}),
+    };
+    const wrapped = wrapToolWithBeforeToolCallHook(tool, hookContext as never);
