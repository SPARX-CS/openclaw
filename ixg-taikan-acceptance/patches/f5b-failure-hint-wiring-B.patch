@@ -0,0 +1,131 @@
+/**
+ * The tool failure hint through the real agent session loop: the before_tool_call wrapper and the
+ * adapter wire the tool exactly as the embedded runner does, and only the model stream is scripted.
+ * Asserts on what the model receives as tool results.
+ */
+import type { AssistantMessage, Context, Model } from "openclaw/plugin-sdk/llm";
+import { Type } from "typebox";
+import { beforeEach, describe, expect, it } from "vitest";
+import { resetDiagnosticSessionStateForTest } from "../logging/diagnostic-session-state.js";
+import { toToolDefinitions } from "./agent-tool-definition-adapter.js";
+import { wrapToolWithBeforeToolCallHook } from "./agent-tools.before-tool-call.js";
+import type { AgentTool } from "./runtime/index.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  streamMocks,
+} from "./sessions/agent-session-loop-correctness.test-support.js";
+
+registerAgentSessionLoopTestLifecycle();
+
+type ToolResultMessage = { role: string; content?: Array<{ type: string; text?: string }> };
+
+function toolResultTexts(context: Context): string[] {
+  return (context.messages as ToolResultMessage[])
+    .filter((message) => message.role === "toolResult")
+    .map((message) =>
+      (message.content ?? []).map((block) => block.text ?? "").join("\n---block---\n"),
+    );
+}
+
+async function runCircling(params: {
+  config?: Record<string, unknown>;
+  calls: number;
+  succeedOnCall?: number;
+}): Promise<string[]> {
+  let executed = 0;
+  const tool = {
+    name: "pdf",
+    label: "PDF",
+    description: "fails with HTTP 401 for any URL",
+    parameters: Type.Object({ url: Type.String() }),
+    execute: async (_id: string, args: { url: string }) => {
+      executed += 1;
+      if (executed === params.succeedOnCall) {
+        return { content: [{ type: "text" as const, text: "summary" }], details: { status: "ok" } };
+      }
+      throw Object.assign(new Error(`Failed to fetch media from ${args.url}: HTTP 401`), {
+        status: 401,
+      });
+    },
+  } as unknown as AgentTool;
+  const hookContext = {
+    agentId: "main",
+    sessionKey: "agent:main:session-loop-hint",
+    sessionId: "session-loop-hint",
+    runId: "run-session-loop-hint",
+    ...(params.config ? { config: params.config } : {}),
+  };
+  const customTools = toToolDefinitions(
+    [wrapToolWithBeforeToolCallHook(tool, hookContext as never)],
+    hookContext as never,
+  );
+  const contexts: Context[] = [];
+  streamMocks.streamSimple.mockImplementation((model: Model, context: Context) => {
+    contexts.push(context);
+    const call = contexts.length;
+    const content: AssistantMessage["content"] =
+      call <= params.calls
+        ? [
+            {
+              type: "toolCall",
+              id: `call-${call}`,
+              name: "pdf",
+              arguments: { url: `https://example.invalid/v${call}/doc.pdf` },
+            },
+          ]
+        : [{ type: "text", text: "done" }];
+    return createAssistantResultStream(
+      createAssistant(model, content, call <= params.calls ? "toolUse" : "stop"),
+    );
+  });
+  const { session } = await createTestSession({ customTools });
+  session.setActiveToolsByName(["pdf"]);
+  await session.prompt("please read the document");
+  return toolResultTexts(contexts[contexts.length - 1]!);
+}
+
+describe("tool failure hint in the session loop", () => {
+  beforeEach(() => {
+    resetDiagnosticSessionStateForTest();
+  });
+
+  it("the model receives the hint with the tool result from the 3rd consecutive failure on", async () => {
+    const results = await runCircling({ calls: 5 });
+    expect(results).toHaveLength(5);
+    expect(results.map((text) => text.includes("[システム通知"))).toEqual([
+      false,
+      false,
+      true,
+      true,
+      true,
+    ]);
+    // The error itself is unchanged and first; the hint is one more block after it.
+    expect(results[2]).toContain('"status": "error"');
+    expect(results[2]).toContain("HTTP 401");
+    expect(results[2]).toContain("別の方法に切り替えるか、利用者へ状況を伝えてください");
+    expect(results[0]).not.toContain("---block---");
+    expect(results[2]).toContain("---block---");
+  });
+
+  it("restarts after a success, and tools.failureHint.afterConsecutiveFailures = 0 turns it off", async () => {
+    resetDiagnosticSessionStateForTest();
+    const afterSuccess = await runCircling({ calls: 6, succeedOnCall: 3 });
+    expect(afterSuccess.map((text) => text.includes("[システム通知"))).toEqual([
+      false,
+      false,
+      false,
+      false,
+      false,
+      true,
+    ]);
+    resetDiagnosticSessionStateForTest();
+    const off = await runCircling({
+      calls: 5,
+      config: { tools: { failureHint: { afterConsecutiveFailures: 0 } } },
+    });
+    expect(off.some((text) => text.includes("[システム通知"))).toBe(false);
+  });
+});
