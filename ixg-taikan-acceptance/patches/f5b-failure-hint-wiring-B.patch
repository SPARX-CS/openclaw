+      description: "fails or succeeds on demand",
+      parameters: Type.Object({ url: Type.Optional(Type.String()) }),
+      execute: async (_id: string, args: { url?: string }) => {
+        calls += 1;
+        const failure = outcomes(calls, args);
+        if (failure) {
+          throw failure;
+        }
+        return { content: [{ type: "text" as const, text: "fetched" }], details: { status: "ok" } };
+      },
+    } as unknown as AgentTool;
+  }
+
+  function embeddedDefinition(tool: AgentTool, config?: Record<string, unknown>) {
+    sessionCounter += 1;
