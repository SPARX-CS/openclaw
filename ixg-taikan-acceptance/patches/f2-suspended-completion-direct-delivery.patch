+/**
+ * Last resort for a required subagent completion whose requester could not be woken.
+ *
+ * The announce flow and the requester-settle wake both go through the requester AGENT. When that
+ * agent cannot run, the row ends up `suspended` and used to be discarded a week later with nobody
+ * told. This module runs once the wake path is finished (the sweeper calls it) and, in order:
+ *   1. sends the child's result (text and any MEDIA: attachments) straight to the requester's
+ *      conversation and mirrors it into the requester session's transcript;
+ *   2. only when that is impossible or fails, tells the user in plain Japanese which request it
+ *      was, that the result could not be delivered, why, and what to do next.
+ * Markers on `delivery.fallback` are written before and after platform I/O, so a retry, a sweeper
+ * tick or a restart never sends the result or the notice twice. Nothing here changes a timeout.
+ */
+import { truncateUtf16Safe } from "@openclaw/normalization-core/utf16-slice";
+import { sanitizePendingFinalDeliveryText } from "../../../auto-reply/reply/pending-final-delivery-state.js";
+import { appendAssistantMessageToSessionTranscript } from "../../../config/sessions/transcript.js";
+import { createSubsystemLogger } from "../../../logging/subsystem.js";
+import { isCronSessionKey } from "../../../sessions/session-key-utils.js";
+import { sanitizeAgentRunTerminalReplyText } from "../../agent-run-terminal-reply.js";
+import { resolveSubagentRequesterAgentId } from "../../subagent-requester-owner.js";
+import {
+  hasAnnounceSendEvidence,
+  resolveSubagentAnnounceTimeoutMs,
+  summarizeDeliveryError,
+} from "../announce/subagent-announce-delivery-retry.js";
+import {
+  getSubagentAnnounceRuntimeConfig,
+  loadRequesterSessionEntry,
+  resolveExternalBestEffortDeliveryTarget,
+  sendSubagentAnnounceMessage,
+} from "../announce/subagent-announce-delivery.runtime.js";
+import {
+  inferDeliveryTargetChatType,
+  resolveAnnounceOrigin,
+} from "../announce/subagent-announce-origin.js";
+import { resolveSubagentCompletionResultText } from "../completion/subagent-completion-result.js";
+import { getSubagentDepthFromSessionStore } from "../spawn/subagent-depth.js";
+import { ensureDeliveryState, isDeliverySuspended } from "./subagent-delivery-state.js";
+import type { SubagentSuspendedFallbackState } from "./subagent-registry-read.types.js";
+import {
+  isSuspendedFallbackFinished,
+  isSuspendedFinalFallbackEligible,
+  peekSuspendedFallbackState,
+} from "./subagent-registry-suspended-delivery.js";
+import type { SubagentRunRecord } from "./subagent-registry.types.js";
+
+const log = createSubsystemLogger("agents/subagent-registry");
+
+const RETRY_BASE_DELAY_MS = 5 * 60_000;
+const RETRY_MAX_DELAY_MS = 6 * 60 * 60_000;
+const REQUEST_SUMMARY_MAX_CHARS = 40;
+
+type FailureClass = NonNullable<SubagentSuspendedFallbackState["failureClass"]>;
+type SendOutcome = "sent" | "suppressed" | "unconfirmed" | "partial" | "failed";
+
+export type SuspendedFinalFallbackOutcome =
+  /** Not a suspended user-facing completion (or it belongs to another owner). */
+  | "skipped"
+  /** An attempt is running or backing off. */
+  | "waiting"
+  /** The result or the notice was already sent earlier. */
+  | "done"
+  | "result_sent"
+  | "notice_sent"
+  /** Neither the result nor the notice could be sent; it will be retried. */
+  | "pending";
+
+const inFlight = new Set<string>();
+/** Rows whose requester is another agent: nothing to tell a user. Process-local, re-derived after a restart. */
+const notUserFacing = new WeakSet<SubagentRunRecord>();
+
+/** Plain-language reason, written for the person who asked (no ids, paths or internals). */
+const NOTICE_REASON: Record<FailureClass, string> = {
+  no_destination: "お届け先の会話を特定できませんでした",
+  empty: "報告できる結果の内容がありませんでした",
+  send_failed: "結果の送信に失敗しました",
+  suppressed: "送信先の設定により送信が見送られました",
+  unconfirmed: "送信の途中で処理が中断され、届いたかどうか確認できませんでした",
+  partial: "結果の一部しか送信できませんでした",
+};
+
+/** What the person can actually do next; never promises a retry the system does not perform. */
+const NOTICE_NEXT_STEP: Record<FailureClass, string> = {
+  no_destination:
+    "管理者に送信先の確認を依頼するか、この会話から同じ依頼をもう一度お送りください。",
+  empty: "依頼の内容をより具体的にして、もう一度お送りください。",
+  send_failed:
+    "お手数ですが、同じ依頼をもう一度お送りください。何度も届かない場合は、管理者に送信状況の確認を依頼してください。",
+  suppressed: "結果が必要な場合は、管理者に送信設定の確認を依頼してください。",
+  unconfirmed: "届いていない場合は、同じ依頼をもう一度お送りください。",
+  partial: "届いていない部分が必要な場合は、その部分だけをもう一度ご依頼ください。",
+};
+
+/** Short, safe wording of the request: label first, then task; URLs, paths and key-like tokens dropped. */
+export function summarizeRequestForNotice(raw: string | undefined): string {
+  const cleaned = (raw ?? "")
+    .replace(/MEDIA:\S+/gi, " ")
+    .replace(/\bhttps?:\/\/\S+/gi, " ")
+    .replace(/(?:^|\s)(?:~|[A-Za-z]:\\|\/)\S*[\\/]\S*/g, " ")
+    .replace(/[A-Za-z0-9_\-+=]{24,}/g, " ")
+    .replace(/[「」\p{Cc}]+/gu, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+  return cleaned.length > REQUEST_SUMMARY_MAX_CHARS
+    ? `${truncateUtf16Safe(cleaned, REQUEST_SUMMARY_MAX_CHARS - 1).trimEnd()}…`
+    : cleaned;
+}
+
+/** The notice: which request, that it finished, where delivery failed, why, and the next step. */
+export function buildSuspendedFinalNotice(params: {
+  requestSummary: string;
+  failureClass: FailureClass;
+  hasMedia?: boolean;
+}): string {
+  const subject = params.requestSummary ? `「${params.requestSummary}」の作業` : "ご依頼の作業";
+  const reason =
+    params.failureClass === "send_failed" && params.hasMedia
+      ? "画像などの添付を含む結果の送信に失敗しました"
+      : NOTICE_REASON[params.failureClass];
+  return `${subject}は終わりましたが、結果をこの会話へお届けできませんでした（${reason}）。${NOTICE_NEXT_STEP[params.failureClass]}`;
+}
+
+function writeState(entry: SubagentRunRecord, patch: Partial<SubagentSuspendedFallbackState>) {
+  const delivery = ensureDeliveryState(entry);
+  delivery.fallback = {
+    ...peekSuspendedFallbackState(entry),
+    ...patch,
+    forSuspendedAt: delivery.suspendedAt,
+  };
+}
+
+function resolveRetryDelayMs(attemptCount: number): number {
+  return Math.min(RETRY_MAX_DELAY_MS, RETRY_BASE_DELAY_MS * 2 ** Math.max(0, attemptCount - 1));
+}
+
+function resolveResultText(entry: SubagentRunRecord): string {
+  const payloadReply = entry.delivery?.payload?.terminalReply;
+  const raw =
+    resolveSubagentCompletionResultText(entry) ??
+    (entry.completion?.terminalReply === undefined && payloadReply?.disposition === "visible"
+      ? payloadReply.text
+      : undefined);
+  return sanitizeAgentRunTerminalReplyText(sanitizePendingFinalDeliveryText(raw ?? ""));
+}
+
+type SendContext = {
+  cfg: ReturnType<typeof getSubagentAnnounceRuntimeConfig>;
+  canonicalKey: string;
+  agentId?: string;
+  storePath?: string;
+  sessionId?: string;
+  target: ReturnType<typeof resolveExternalBestEffortDeliveryTarget>;
+};
+
+/** Where the requester's conversation is, from the row's requesterOrigin and the session's own route. */
+function resolveSendContext(entry: SubagentRunRecord): SendContext | undefined {
+  const cfg = getSubagentAnnounceRuntimeConfig();
+  const requesterAgentId = resolveSubagentRequesterAgentId(cfg, entry);
+  // Another agent (nested subagent, cron run) is the requester: there is no user conversation to tell.
+  if (
+    isCronSessionKey(entry.requesterSessionKey) ||
+    getSubagentDepthFromSessionStore(entry.requesterSessionKey, {
+      cfg,
+      agentId: requesterAgentId,
+    }) >= 1
+  ) {
+    return undefined;
+  }
+  const requester = loadRequesterSessionEntry(entry.requesterSessionKey, requesterAgentId);
+  const origin = resolveAnnounceOrigin(
+    requester.entry,
+    entry.delivery?.payload?.requesterOrigin ?? entry.requesterOrigin,
+  );
+  return {
+    cfg,
+    canonicalKey: requester.canonicalKey,
+    agentId: requester.agentId ?? requesterAgentId,
+    storePath: requester.storePath,
+    sessionId: requester.entry?.sessionId,
+    target: resolveExternalBestEffortDeliveryTarget({
+      channel: origin?.channel,
+      to: origin?.to,
+      accountId: origin?.accountId,
+      threadId: origin?.threadId,
+    }),
+  };
+}
+
+async function sendToRequester(
+  context: SendContext,
+  args: { content: string; idempotencyKey: string; onCommitted?: () => void },
+): Promise<{ outcome: SendOutcome; error?: string }> {
+  let committed = false;
+  try {
+    const sent = await sendSubagentAnnounceMessage({
+      cfg: context.cfg,
+      channel: context.target.channel,
+      to: context.target.to ?? "",
+      accountId: context.target.accountId,
+      threadId: context.target.threadId,
+      requesterSessionKey: context.canonicalKey,
+      ...(context.agentId ? { agentId: context.agentId } : {}),
+      conversationType: inferDeliveryTargetChatType({
+        channel: context.target.channel,
+        to: context.target.to,
+      }),
+      content: args.content,
+      idempotencyKey: args.idempotencyKey,
+      // Our own markers own retry and deduplication; a replayable queue entry would send it twice.
+      skipQueue: true,
+      // The existing announce timeout (agents.defaults.subagents.announceTimeoutMs) bounds each send.
+      abortSignal: AbortSignal.timeout(resolveSubagentAnnounceTimeoutMs(context.cfg)),
+      onDeliveryResult: () => {
+        if (!committed) {
+          committed = true;
+          args.onCommitted?.();
+        }
+      },
+      // Records the delivered message in the requester session's transcript.
+      mirror: {
+        sessionKey: context.canonicalKey,
+        ...(context.agentId ? { agentId: context.agentId } : {}),
+        idempotencyKey: args.idempotencyKey,
+      },
+    });
+    if (committed) {
+      return { outcome: "sent" };
+    }
+    if (sent.deliveryStatus === "suppressed") {
+      return {
+        outcome:
+          sent.suppressionReason === "adapter_returned_no_identity" ? "unconfirmed" : "suppressed",
+      };
+    }
+    if (sent.deliveryStatus === "partial_failed") {
+      return { outcome: "partial", error: sent.error };
+    }
+    if (sent.deliveryStatus === "failed") {
+      return { outcome: sent.sentBeforeError ? "partial" : "failed", error: sent.error };
+    }
+    return { outcome: "sent" };
+  } catch (error) {
+    // Post-send bookkeeping must never turn an identified delivery into a second send.
+    if (committed) {
+      return { outcome: "sent" };
+    }
+    return {
+      outcome: hasAnnounceSendEvidence(error) ? "partial" : "failed",
+      error: summarizeDeliveryError(error),
+    };
+  }
+}
+
+/**
+ * Delivers the result of a suspended completion, or tells the user it could not be delivered.
+ * Safe to call repeatedly: an already delivered or announced row returns "done" without I/O.
+ * `backstop` (used right before the 7-day discard) ignores the retry backoff.
+ */
+export async function deliverSuspendedFinalFallback(params: {
+  entry: SubagentRunRecord;
+  runs: ReadonlyMap<string, SubagentRunRecord>;
+  persist: (...runIds: string[]) => void;
+  now?: number;
+  backstop?: boolean;
+}): Promise<SuspendedFinalFallbackOutcome> {
+  const { entry } = params;
+  if (!isSuspendedFinalFallbackEligible(entry)) {
+    return "skipped";
+  }
+  const now = params.now ?? Date.now();
+  const initial = peekSuspendedFallbackState(entry);
+  if (isSuspendedFallbackFinished(initial)) {
+    return "done";
+  }
+  if (!params.backstop && (initial.nextAttemptAt ?? 0) > now) {
+    return "waiting";
+  }
+  const lock = `${entry.runId}:${entry.delivery?.suspendedAt}`;
+  if (notUserFacing.has(entry)) {
+    return "skipped";
+  }
+  if (inFlight.has(lock)) {
+    return "waiting";
+  }
+  inFlight.add(lock);
+  try {
+    const outcome = await runAttempt({ ...params, now });
+    if (outcome === "skipped") {
+      notUserFacing.add(entry);
+    }
+    return outcome;
+  } finally {
+    inFlight.delete(lock);
+  }
+}
+
+async function runAttempt(params: {
+  entry: SubagentRunRecord;
+  runs: ReadonlyMap<string, SubagentRunRecord>;
+  persist: (...runIds: string[]) => void;
+  now: number;
+}): Promise<SuspendedFinalFallbackOutcome> {
+  const { entry, runs, now } = params;
+  const runId = entry.runId;
+  const isCurrent = () => runs.get(runId) === entry && isDeliverySuspended(entry);
+  const update = (patch: Partial<SubagentSuspendedFallbackState>) => {
+    writeState(entry, patch);
+    if (runs.get(runId) === entry) {
+      params.persist(runId);
+    }
+  };
+  // Retry bookkeeping is pointless right before the row is discarded (the backstop ignores backoff):
+  // only what was actually sent, or may have been, is recorded then, so a row nothing could be done
+  // for stays exactly as it was.
+  const bookkeep = (patch: Partial<SubagentSuspendedFallbackState>) => {
+    if (!params.backstop) {
+      update(patch);
+    }
+  };
+  const idempotencyBase = `subagent-suspended-final:${runId}:${entry.delivery?.suspendedAt ?? 0}`;
+  const before = { ...peekSuspendedFallbackState(entry) };
+  let context: SendContext | undefined;
+  try {
+    context = resolveSendContext(entry);
+  } catch (error) {
+    log.warn("subagent suspended delivery could not resolve the requester conversation", {
+      runId,
+      error: summarizeDeliveryError(error),
+    });
+    bookkeep({
+      attemptCount: (before.attemptCount ?? 0) + 1,
+      lastAttemptAt: now,
+      nextAttemptAt: now + resolveRetryDelayMs((before.attemptCount ?? 0) + 1),
+    });
+    return "pending";
+  }
+  if (!context) {
+    return "skipped";
+  }
+  bookkeep({ attemptCount: (before.attemptCount ?? 0) + 1, lastAttemptAt: now });
+  const payload = entry.delivery?.payload;
+  const resultText = resolveResultText(entry);
+  const hasMedia = /(?:^|\n)\s*MEDIA:/i.test(resultText);
+
+  let failure: FailureClass | undefined;
+  if (before.failureClass === "unconfirmed" || before.failureClass === "partial") {
+    // Both mean part of the result may already have reached the user; never send it again.
+    failure = before.failureClass;
+  } else if (before.resultAttemptAt !== undefined && before.resultSentAt === undefined) {
+    // An earlier process stopped between "about to send" and an outcome.
+    failure = "unconfirmed";
+  } else if (!context.target.deliver) {
+    failure = "no_destination";
+  } else if (!resultText) {
+    failure = "empty";
+  } else {
+    // 1. The result itself, to the requester's own conversation.
+    update({ resultAttemptAt: now, failureClass: undefined });
+    const result = await sendToRequester(context, {
+      content: resultText,
+      idempotencyKey: `${idempotencyBase}:result`,
+      onCommitted: () => update({ resultSentAt: Date.now(), resultAttemptAt: undefined }),
+    });
+    if (result.outcome === "sent") {
+      if (peekSuspendedFallbackState(entry).resultSentAt === undefined) {
+        update({ resultSentAt: Date.now() });
+      }
+      update({ resultAttemptAt: undefined, nextAttemptAt: undefined });
+      log.info("subagent suspended delivery sent directly to the requester conversation", {
+        runId,
+        hasMedia,
+      });
+      return "result_sent";
+    }
+    update({ resultAttemptAt: undefined });
+    if (result.outcome === "partial") {
+      update({ resultSentAt: Date.now() });
+    }
+    failure =
+      result.outcome === "failed"
+        ? "send_failed"
+        : result.outcome === "partial"
+          ? "partial"
+          : result.outcome;
+    log.warn("subagent suspended delivery could not be sent directly", {
+      runId,
+      failure,
+      ...(result.error ? { error: result.error } : {}),
+    });
+  }
+
+  // 2. Tell the user, in plain words, that the result could not be delivered.
+  if (failure === "partial" || failure === "unconfirmed") {
+    update({ failureClass: failure }); // sticky: the result must never be sent again
+  } else {
+    bookkeep({ failureClass: failure });
+  }
+  if (!isCurrent()) {
+    return "waiting";
+  }
+  const notice = buildSuspendedFinalNotice({
+    requestSummary: summarizeRequestForNotice(
+      entry.label?.trim() || payload?.label?.trim() || payload?.task || entry.task,
+    ),
+    failureClass: failure,
+    hasMedia,
+  });
+  const noticeKey = `${idempotencyBase}:notice`;
+  const finishNotice = (sent: boolean): SuspendedFinalFallbackOutcome => {
+    if (sent) {
+      update({ noticeSentAt: Date.now(), nextAttemptAt: undefined });
+      log.info("subagent suspended delivery reported to the requester conversation", {
+        runId,
+        failure,
+      });
+      return "notice_sent";
+    }
+    bookkeep({
+      nextAttemptAt: now + resolveRetryDelayMs(peekSuspendedFallbackState(entry).attemptCount ?? 1),
+    });
+    return "pending";
+  };
+  if (context.target.deliver) {
+    const sent = await sendToRequester(context, { content: notice, idempotencyKey: noticeKey });
+    if (sent.outcome === "sent" || sent.outcome === "partial") {
+      return finishNotice(true);
+    }
+    // A channel that suppresses every send can still take the notice into the session record.
+    if (sent.outcome !== "suppressed") {
+      log.warn("subagent suspended delivery notice could not be sent", {
+        runId,
+        ...(sent.error ? { error: sent.error } : {}),
+      });
+      return finishNotice(false);
+    }
+  }
+  const recorded = await appendAssistantMessageToSessionTranscript({
+    ...(context.agentId ? { agentId: context.agentId } : {}),
+    sessionKey: context.canonicalKey,
+    ...(context.sessionId ? { expectedSessionId: context.sessionId } : {}),
+    ...(context.storePath ? { storePath: context.storePath } : {}),
+    text: notice,
+    idempotencyKey: noticeKey,
+  }).catch((error: unknown) => ({ ok: false as const, reason: summarizeDeliveryError(error) }));
+  if (!recorded.ok) {
+    log.warn("subagent suspended delivery notice could not be recorded", {
+      runId,
+      reason: recorded.reason,
+    });
+  }
+  return finishNotice(recorded.ok);
+}
