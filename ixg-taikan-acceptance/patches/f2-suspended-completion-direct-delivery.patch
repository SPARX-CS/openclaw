+  it("gives the fallback a last chance before the row is discarded and says how it was served", async () => {
+    const entry = makeRow();
+    const order: string[] = [];
+    const { promise, warn, discardTerminalDelivery } = discard(entry, async () => {
+      order.push("fallback");
+      entry.delivery = {
